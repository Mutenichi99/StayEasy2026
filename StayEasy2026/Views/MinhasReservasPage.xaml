<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StayEasy2026.Models"
             x:Class="StayEasy2026.Views.MinhasReservasPage"
             Title="Minhas reservas" BackgroundColor="{StaticResource Navy}">
  <Grid Padding="22,22,22,24" RowDefinitions="Auto,*,Auto" RowSpacing="15"
        MaximumWidthRequest="760" HorizontalOptions="Fill">
    <VerticalStackLayout Grid.Row="0" Spacing="6">
      <Label Text="Minhas reservas" Style="{StaticResource PageTitle}" />
      <Label x:Name="ContagemLabel" Style="{StaticResource BodyMuted}" Text="Histórico local" />
    </VerticalStackLayout>
    <CollectionView x:Name="ReservasCollection" Grid.Row="1" SelectionMode="None"
                    ItemsLayout="VerticalList">
      <CollectionView.EmptyView>
        <VerticalStackLayout Padding="15,60,15,30" Spacing="13">
          <Label Text="◇" FontSize="54" TextColor="{StaticResource Gold}"
                 HorizontalTextAlignment="Center" />
          <Label Text="Nenhuma reserva por aqui" Style="{StaticResource SectionTitle}"
                 HorizontalTextAlignment="Center" />
          <Label Text="Quando você fizer uma reserva, ela aparecerá nesta lista."
                 Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:Reserva">
          <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}"
                  StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="17" Margin="0,0,0,14">
            <VerticalStackLayout Spacing="9">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="{Binding Quarto}" FontSize="19" FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Grid.Column="1" Text="CONFIRMADA" TextColor="{StaticResource Positive}"
                       FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
              </Grid>
              <Label Text="{Binding Hospede}" FontSize="16" TextColor="{StaticResource White}" />
              <Label Text="{Binding PeriodoTexto}" Style="{StaticResource BodyMuted}" />
              <Label Text="{Binding HospedesTexto}" Style="{StaticResource BodyMuted}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding CodigoTexto}" Style="{StaticResource BodyMuted}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TotalTexto}" FontSize="20"
                       FontAttributes="Bold" TextColor="{StaticResource Gold}" />
              </Grid>
              <Button Text="Cancelar esta reserva" CommandParameter="{Binding Codigo}"
                      BackgroundColor="#643B48" TextColor="{StaticResource White}"
                      CornerRadius="12" HeightRequest="44" Clicked="OnCancelarClicked" />
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <Button Grid.Row="2" Text="+ Criar outra reserva" Style="{StaticResource PrimaryButton}"
            Clicked="OnNovaReservaClicked" />
  </Grid>
</ContentPage>
