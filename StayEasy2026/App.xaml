<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StayEasy2026.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Navy">#0C1E2E</Color>
      <Color x:Key="Surface">#142F45</Color>
      <Color x:Key="SurfaceSoft">#1D3B51</Color>
      <Color x:Key="Gold">#F3C67D</Color>
      <Color x:Key="White">#FFFFFF</Color>
      <Color x:Key="Muted">#B7C8D4</Color>
      <Color x:Key="Line">#39566B</Color>
      <Color x:Key="Input">#ECF3F8</Color>
      <Color x:Key="Ink">#10283C</Color>
      <Color x:Key="Positive">#9BE9B8</Color>
      <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
      </Style>
      <Style x:Key="BodyMuted" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
      </Style>
      <Style x:Key="InputLabel" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
        <Setter Property="TextColor" Value="{StaticResource Navy}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="54" />
      </Style>
      <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSoft}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
      </Style>
      <Style x:Key="TextEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource Input}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="#718394" />
        <Setter Property="HeightRequest" Value="52" />
      </Style>
      <Style x:Key="SelectPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource Input}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="TitleColor" Value="#718394" />
        <Setter Property="HeightRequest" Value="52" />
      </Style>
      <Style x:Key="SelectDate" TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="{StaticResource Input}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="Format" Value="dd/MM/yyyy" />
        <Setter Property="HeightRequest" Value="52" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
